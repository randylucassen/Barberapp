# Kopieer dit bestand naar .env.local en vul de waarden in vanuit je
# Supabase-project: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role (geheim — nooit client-side
# gebruiken, alleen in Route Handlers). Nodig sinds Fase 6.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe-dashboard (test mode lokaal, live mode in productie) ->
# Developers -> API keys. Nodig sinds Fase 6.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers -> Webhooks (of `stripe listen` lokaal) -> signing secret.
# In productie een nieuw, apart webhook-endpoint tegen de productie-URL
# aanmaken -> eigen secret, niet de lokale/test-waarde hergebruiken.
STRIPE_WEBHOOK_SECRET=

# Zelf een willekeurige, geheime string verzinnen — beveiligt
# /api/cron/release-escrow tegen aanroepen door iemand anders dan pg_cron.
CRON_SECRET=

# Resend-dashboard -> API Keys. Nodig sinds Fase 8. In sandbox-modus kan
# alleen naar je eigen accountadres gemaild worden — voor echte klant-/
# barber-mails moet je in het Resend-dashboard eerst een domein
# verifiëren (zie "Openstaande acties" in PROJECT.md).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Gegenereerd met `npx web-push generate-vapid-keys` (Fase 8) — eenmalig,
# blijven hetzelfde in test en productie.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jouw-email@voorbeeld.nl

# Upstash-dashboard (gratis Redis-database) -> REST API, of de Vercel
# Marketplace-integratie voor Upstash die dit automatisch invult. Nodig
# sinds Fase 11 — zonder deze twee vars is er simpelweg geen rate limit
# (prima voor lokaal ontwikkelen, wel nodig in productie).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry-project -> Settings -> Client Keys (DSN). Nodig sinds Fase 11.
# Zonder deze var initialiseert Sentry simpelweg niet (geen foutmelding).
NEXT_PUBLIC_SENTRY_DSN=

# Absolute basis-URL van de app, zonder trailing slash (bv.
# https://groomy.vercel.app of je eigen domein zodra je dat hebt) —
# gebruikt voor OG-tags/sitemap.xml/robots.txt. Zonder deze var valt de
# app terug op Vercel's automatische VERCEL_URL, en lokaal op
# localhost:3000.
NEXT_PUBLIC_SITE_URL=

# mapbox.com/account/access-tokens (gratis account, geen creditcard
# nodig). Nodig sinds de live-locatiekaart-feature (klant/status,
# barber/rit). Zonder deze var valt LiveMap netjes terug op de oude
# statische placeholder — niets breekt, de kaart wordt alleen pas
# zichtbaar zodra dit token er is. Publieke/client-token, bewust
# NEXT_PUBLIC_ (Mapbox-tokens zijn URL-restricted te beveiligen in het
# dashboard, niet bedoeld als geheim zoals STRIPE_SECRET_KEY).
NEXT_PUBLIC_MAPBOX_TOKEN=
